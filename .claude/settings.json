{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-merge-gate.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh",
            "timeout": 240,
            "statusMessage": "Checking changes..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)"
    ]
  },
  "skillOverrides": {
    "wsetup": "user-invocable-only",
    "wdist": "user-invocable-only"
  }
}
