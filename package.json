{
  "name": "yaymatik",
  "private": true,
  "scripts": {
    "dev": "([ -f vendor/autoload.php ] || ./run.sh setup) && pnpm -F @yaymatik/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "lint:php": "dev/tools/lintphp/vendor/bin/phpcs",
    "lint:php:fix": "dev/tools/lintphp/vendor/bin/phpcbf",
    "test": "pnpm -r test",
    "test:php": "dev/tools/phpunit/vendor/bin/phpunit",
    "e2e": "pnpm build && playwright test -c dev/e2e/playwright.config.ts",
    "format": "pnpm -r format",
    "analyze": "pnpm -F @yaymatik/admin analyze"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@wordpress/env": "12.1.0"
  }
}
