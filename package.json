{
  "name": "yay-automation",
  "private": true,
  "scripts": {
    "dev": "([ -f vendor/autoload.php ] || ./run.sh setup) && pnpm -F @yay-automation/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "lint:php": "dev/tools/lintphp/vendor/bin/phpcs",
    "lint:php:fix": "dev/tools/lintphp/vendor/bin/phpcbf",
    "test": "pnpm -r test",
    "test:php": "dev/tools/phpunit/vendor/bin/phpunit",
    "format": "pnpm -r format",
    "analyze": "pnpm -F @yay-automation/admin analyze"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  }
}
